# syntax=docker/dockerfile:1.7
# Separate one-shot candidate. No application HTTP server, no embedded baseline
# archive/Secret, no cloud activation or publication at image build time.
FROM postgres:16.14-trixie@sha256:95206741a5b214807675e14165369d05b93a9cf692223b616d07cca227e74b0b AS pg-tools
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2 AS runtime-base
FROM node:24.18.0-bookworm-slim@sha256:6f7b03f7c2c8e2e784dcf9295400527b9b1270fd37b7e9a7285cf83b6951452d AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM python:3.14.8-slim-trixie@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2 AS runtime-tools
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 liblz4-1 libzstd1 ca-certificates curl \
    && curl --fail --silent --show-error --location https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem --output /aws-rds-global-bundle.pem \
    && echo "fe45bbebf92ad3e27a583bbb2ddd1553c521ed4d49af5514dc0a40372ea5395c  /aws-rds-global-bundle.pem" | sha256sum --check --strict \
    && chmod 0444 /aws-rds-global-bundle.pem && rm -rf /var/lib/apt/lists/*
COPY --from=pg-tools /usr/lib/postgresql/16/bin/pg_restore /usr/local/bin/pg_restore16
COPY --from=pg-tools /usr/lib/x86_64-linux-gnu/libpq.so.5* /usr/local/lib/
COPY --from=pg-tools /var/lib/dpkg/status /pg-source-status
COPY --from=runtime-base / /runtime-base/
COPY scripts/ci/build-lifecycle-runtime.py /build-lifecycle-runtime.py
RUN ldconfig
RUN python3 /build-lifecycle-runtime.py && chown 65532:65532 /runtime-overlay/tmp/tenant-lifecycle

# Only selected tool binaries/stdlib/ELF dependencies enter the final layer.
# Keep base dpkg metadata plus copied-library metadata; do not hide versions.
FROM runtime-base AS lifecycle
COPY --from=runtime-tools /runtime-overlay/ /
COPY --from=runtime-tools /aws-rds-global-bundle.pem /usr/local/share/ca-certificates/aws-rds-global-bundle.pem
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY services/saas ./services/saas
COPY db/tenant_lifecycle_prepared.js ./db/tenant_lifecycle_prepared.js
COPY db/saas_control.sql db/theme_config.sql ./db/
COPY scripts/render_tenant_baseline_verification.py scripts/tenant_baseline_schema_profile.py ./scripts/
COPY scripts/verify-empty-tenant-baseline-pg16.js ./scripts/verify-empty-tenant-baseline-pg16.js
COPY scripts/ci/check-lifecycle-image-toolchain.js ./scripts/ci/check-lifecycle-image-toolchain.js
ENV PATH=/usr/local/bin:/usr/bin:/bin NODE_ENV=production PGSSLMODE=verify-full PGSSL_REJECT_UNAUTHORIZED=true \
    PGSSLROOTCERT=/usr/local/share/ca-certificates/aws-rds-global-bundle.pem
USER 65532:65532
RUN ["/usr/local/bin/pg_restore16", "--version"]
RUN ["/usr/bin/python3", "-I", "-c", "import sys,ssl; assert sys.version_info[:3] == (3,14,8); print(sys.version); ctx=ssl.create_default_context(); assert ctx.check_hostname; failed=False\ntry: ctx.wrap_bio(ssl.MemoryBIO(),ssl.MemoryBIO())\nexcept ValueError: failed=True\nassert failed, 'CVE-2026-19553 regression'"]
RUN ["/usr/local/bin/node", "db/tenant_lifecycle_prepared.js", "--check-bundle"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/node", "db/tenant_lifecycle_prepared.js"]
CMD ["--check-bundle"]
