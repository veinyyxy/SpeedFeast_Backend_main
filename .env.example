# Runtime. The production container is pinned to Node.js 24.18.0.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8080
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
VERIFICATION_RATE_LIMIT_PER_MINUTE=10
SAAS_RATE_LIMIT_PER_MINUTE=120

# PostgreSQL (DATABASE_URL takes precedence when provided)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=SpeedFeastMain
PGUSER=postgres
PGPASSWORD=replace-me
# Local PostgreSQL normally uses disable. The production image defaults to
# verify-full with the bundled AWS RDS CA and refuses weaker TLS settings.
PGSSLMODE=disable
PGSSL_REJECT_UNAUTHORIZED=true
# Production and the migration image require this exact image-bundled path.
PGSSLROOTCERT=/usr/local/share/ca-certificates/aws-rds-global-bundle.pem
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
PGAPPNAME=speedfeast-backend

# Request signing and authentication
HMAC_SECRET_KEY=replace-me
JWT_SECRET_KEY=replace-me
JWT_EXPIRES_IN=7d
MERCHANT_JWT_EXPIRES_IN=12h

# SaaS control plane. The public key may use literal \n sequences in one line.
# Keep these unset only when the SaaS control API is intentionally unavailable.
SAAS_CONTROL_PUBLIC_KEY=
SAAS_JWT_ISSUER=https://saas.example.com
SAAS_INSTANCE_ID=replace-with-app-instance-id
SAAS_JWT_AUDIENCE=speedfeast-instance:replace-with-app-instance-id
SAAS_LICENSE_AUDIENCE=speedfeast-instance-license
SAAS_JWT_ALGORITHMS=RS256
SAAS_REQUIRE_INSTANCE_CLAIM=true
SAAS_REQUIRE_MTLS=true
# Enable this only when the backend is private behind a trusted proxy that
# removes the inbound header and sets it after client-certificate validation.
SAAS_TRUST_PROXY_MTLS_HEADER=true
# Local trusted proxies may use verified_header. AWS Sandbox and production
# must override this to aws_alb_verify and restrict the task security group to
# the ALB security group.
SAAS_MTLS_PROXY_MODE=verified_header
SAAS_MTLS_VERIFIED_HEADER=x-saas-client-cert-verified
# Production requires the immutable deployed image digest: sha256:<64 hex>.
APP_IMAGE_REVISION=

# Product image storage. Use local for development. Production local storage is
# only for the controlled single-tenant Sandbox canary; the platform injects
# both exact gates. Do not enable them manually or use the mode for real assets.
IMAGE_STORAGE_PROVIDER=local
APP_RUNTIME_MODE=
ALLOW_EPHEMERAL_IMAGE_STORAGE=false
IMAGE_S3_BUCKET=
IMAGE_PUBLIC_BASE_URL=
AWS_REGION=ca-central-1

# Stripe
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://buyer.example.com/payment-success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://buyer.example.com/payment-cancel?session_id={CHECKOUT_SESSION_ID}

# Firebase Cloud Messaging: use either JSON or the three individual fields.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Verification providers
SENDGRID_API_KEY=
SMS_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Rewards
REWARD_POINTS_PER_CAD=1

# One-shot tenant baseline migration task only. There is currently no approved
# baseline artifact: leave all values blank so the task fails closed. The
# APPROVED digest must come from a separately reviewed deployment allowlist,
# never from the downloaded manifest or a customer-controlled request.
MIGRATION_S3_URI=
MIGRATION_SHA256=
MIGRATION_MANIFEST_S3_URI=
MIGRATION_MANIFEST_SHA256=
APPROVED_TENANT_BASELINE_SHA256=
MIGRATION_CONFIRM_SOURCE_DATABASE=
MIGRATION_CONFIRM_HOST=
MIGRATION_CONFIRM_DATABASE=
MIGRATION_CONFIRM_ADMIN_USER=
APP_DB_USER=
APP_DB_PASSWORD=

# ECS one-shot tenant lifecycle inspect only. These are trusted platform
# readback fields, not operator-provided application configuration. Production
# also requires APP_RUNTIME_MODE=aws_sandbox_tenant_lifecycle_inspect and the
# exact image-bundled PGSSL* values above. Never place Secret JSON/passwords in
# this file or in an ECS environment override.
TENANT_DATABASE_OPERATION=
TENANT_RUNTIME_SECRET_ARN=
TENANT_CELL_ID=
TENANT_CELL_CLUSTER_ARN=
TENANT_DATABASE_CLUSTER_IDENTIFIER=
TENANT_DATABASE_MANAGEMENT_ENDPOINT=
TENANT_DATABASE_MANAGEMENT_PORT=
TENANT_DATABASE_MANAGEMENT_SECRET_ARN=
TENANT_DATABASE_MANAGEMENT_DATABASE=
TENANT_DATABASE_MANAGEMENT_USERNAME=
TENANT_DATABASE_NAME=
TENANT_DATABASE_ROLE_NAME=
TENANT_SHARED_CELL_EVIDENCE_SHA256=
TENANT_RESOURCE_GENERATION=
TENANT_OWNERSHIP_MARKER=
TENANT_EXTERNAL_OPERATION_EPOCH=
TENANT_EXTERNAL_OPERATION_MARKER=
TENANT_EXTERNAL_OPERATION_HASH=
TENANT_RECEIPT_BUCKET=
TENANT_RECEIPT_EXPECTED_BUCKET_OWNER=
TENANT_RECEIPT_KEY=
